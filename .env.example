# Common portal options; supply these through your own bootstrap or environment.
PUBLIC_ORIGIN=https://onboarding.example.com
PARTNER_NAME="Your Partner"
PORT=8080

# Only the included Azure/email-OTP reference bootstrap reads the values below.
# The portal factory does not require Azure hosting or these environment names.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
STORAGE_URL=https://your-storage.blob.core.windows.net
KEY_VAULT_URL=https://your-vault.vault.azure.net
ACS_ENDPOINT=https://your-communication-resource.communication.azure.com
EMAIL_SENDER=onboarding@mail.example.com
EMAIL_ENABLED=false
ALLOWED_EMAILS=["operator@example.com"]
