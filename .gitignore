node_modules/
coverage/
.tools/
dist/
*.zip
.deploy/

# Per-installation deployment notes and generated customer connection exports.
.azure/
onboarding-connection*.json
*.log

# Local credentials and certificate material.
*.key
*.pem
*.pfx
*.p12
